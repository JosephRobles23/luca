{
  "name": "luca",
  "version": "0.1.0",
  "private": true,
  "description": "Gestión de gastos personales sobre el Google del usuario: Apps Script + web + MCP",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs apps/web/src/lib/*.test.mjs",
    "lib:push": "clasp push --project gas/shared",
    "lib:version": "clasp create-version --project gas/shared",
    "stub:push": "clasp push --project gas/stub",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
