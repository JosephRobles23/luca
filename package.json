{
  "name": "luca",
  "version": "0.1.0",
  "private": true,
  "description": "Gestión de gastos personales sobre el Google del usuario: Apps Script + web + MCP",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs apps/web/src/lib/*.test.mjs services/luca-mcp/test/*.test.mjs",
    "mcp:typecheck": "npm --prefix services/luca-mcp run typecheck",
    "mcp:deploy": "npm --prefix services/luca-mcp run deploy",
    "lib:push": "clasp push --project gas/shared --force",
    "lib:version": "clasp create-version --project gas/shared",
    "stub:push": "clasp push --project gas/stub --force",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "release:check": "node scripts/release-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
