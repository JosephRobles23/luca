# Auth.js — cliente OAuth "Luca Web" del proyecto GCP luca-510610 (NO "Luca Web (spikes)", que es solo para spikes/).
# Las URIs de redirección (…/api/auth/callback/google) y los orígenes deben estar registrados en ESTE cliente.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Picker de Google (clave de API restringida al Picker y número de proyecto)
NEXT_PUBLIC_GOOGLE_PICKER_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
# Plantilla "Luca Template" y su carpeta "LUCA" (cuenta petter.chuquipiondo.r@gmail.com, compartidas: cualquiera con el enlace, lector).
# El onboarding enlaza la carpeta y abre el selector de Google dentro de ella para elegir la plantilla.
NEXT_PUBLIC_TEMPLATE_SHEET_ID=1kQWNaj9J29LRK-LsdCAxrplW06heaTvS3Hje3NV1htg
NEXT_PUBLIC_TEMPLATE_FOLDER_ID=18aQXOYlyznY6xZm3ViRdVrFWILLXsHQL
# Última versión publicada de LucaLib: la web avisa si la copia del usuario (Ajustes.luca.version) es anterior
NEXT_PUBLIC_LUCA_LIB_VERSION=3

# Desarrollo/e2e sin Google: sesión falsa + Sheet en memoria (npm run dev:mock / npm run e2e)
# LUCA_MOCK=1

# Enlace de iCloud del atajo "Luca – Captura Yape" (ADR-003). Vacío = usa el publicado (SHORTCUT_URL en
