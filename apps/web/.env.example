# Auth.js — cliente OAuth "Luca Web" del proyecto GCP luca-510610 (NO "Luca Web (spikes)", que es solo para spikes/).
# Las URIs de redirección (…/api/auth/callback/google) y los orígenes deben estar registrados en ESTE cliente.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Picker de Google (clave de API restringida al Picker y número de proyecto)
NEXT_PUBLIC_GOOGLE_PICKER_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
# Plantilla "Luca — Plantilla"
NEXT_PUBLIC_TEMPLATE_SHEET_ID=1FMxSE00KcD68JdClICcWayMxdqvSROYr6tuL-va5KWA
# Última versión publicada de LucaLib: la web avisa si la copia del usuario (Ajustes.luca.version) es anterior
NEXT_PUBLIC_LUCA_LIB_VERSION=13

# Desarrollo/e2e sin Google: sesión falsa + Sheet en memoria (npm run dev:mock / npm run e2e)
# LUCA_MOCK=1

# Enlace de iCloud del atajo "Luca – Captura Yape" (ADR-003). Vacío = aún no publicado: el asistente "Conectar iPhone"
# oculta "Instalar atajo" y ofrece primero el prompt para generarlo con IA.
NEXT_PUBLIC_SHORTCUT_URL=
